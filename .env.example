# Cosmic API credentials
COSMIC_BUCKET_SLUG=your-bucket-slug
COSMIC_READ_KEY=your-read-key
COSMIC_WRITE_KEY=your-write-key

# Customer sessions and CAP tokens (32+ random characters)
AUTH_SECRET=

# Stripe (test mode keys while developing)
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe dashboard webhook endpoint, or from `stripe listen` locally
STRIPE_WEBHOOK_SECRET=whsec_...

# Public origin used in confirm links and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cosmic Insights
COSMIC_INSIGHTS_PROJECT=6a9b7a5d254225867de1da06
NEXT_PUBLIC_COSMIC_INSIGHTS_PROJECT=6a9b7a5d254225867de1da06
